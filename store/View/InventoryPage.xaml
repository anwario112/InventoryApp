<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="store.View.InventoryPage"
             Title="InventoryPage" BackgroundColor="{StaticResource Gray1000}">
    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" BackgroundColor="{StaticResource teal}" Padding="10">

            <Grid RowDefinitions="Auto, Auto">

                <Label 

                Grid.Row="0"

                Text="Scan Barcode"

                TextColor="White"

                FontFamily="roman"

                Padding="10,10,10,5"

                FontSize="22" />


                <Border 

                Grid.Row="1"

                BackgroundColor="#20FFFFFF" 

                Stroke="Transparent"

                StrokeThickness="1"

                Padding="5"

                HorizontalOptions="Fill"

                VerticalOptions="Center"

                Margin="10,10,10,10">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="10" />

                    </Border.StrokeShape>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />


                            <ColumnDefinition Width="Auto" />


                        </Grid.ColumnDefinitions>


                        <Entry 

                        Placeholder="Search to add an Item"

                        BackgroundColor="Transparent"

                        TextColor="White"

                        FontFamily="roman"

                        HorizontalOptions="FillAndExpand"

                        Margin="0,0,5,0"

                        HeightRequest="40"

                        x:Name="Barcode"

                        IsVisible="true"
                        Text="{Binding BarcodeText}"

                        TextChanged="Barcode_TextChanged"/>

                        <Image Source="camera.png" HeightRequest="25" WidthRequest="25" HorizontalOptions="End" Margin="0,0,20,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>





                    </Grid>

                </Border>

            </Grid>


            <Image Source="delete.png" HeightRequest="35" WidthRequest="35" Margin="280,0,0,70">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_2" />
                </Image.GestureRecognizers>
            </Image>

            <Image Source="saving.png" HeightRequest="35" WidthRequest="35" Margin="140,0,0,70">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_3" />
                </Image.GestureRecognizers>
            </Image>


        </Grid>


        <Grid Grid.Row="1" Padding="10">
            <ScrollView>
                <StackLayout>
                    <BoxView HeightRequest="1" 
                        BackgroundColor="{StaticResource Black}" 
                         HorizontalOptions="Fill" 
                         VerticalOptions="Start" 
                         IsVisible="False"
                         x:Name="SearchLine"/>


                    <ActivityIndicator x:Name="LoadingSpinner" IsVisible="False" IsRunning="False" />
                    <CollectionView ItemsSource="{Binding ItemCards}" Margin="0,10,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Transparent"
                    StrokeThickness="2"
                    BackgroundColor="{StaticResource White}"
                    HeightRequest="90"
                    WidthRequest="310"
                    Margin="10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Grid Padding="0">
                                      
                                        <BoxView WidthRequest="10" 
                             BackgroundColor="{StaticResource teal}" 
                             HorizontalOptions="Start" 
                             VerticalOptions="Fill" />

                                   
                                        <Image Source="cardbarcode.png" 
                           HeightRequest="40" 
                           WidthRequest="40" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Start" 
                           Margin="20,-10,0,0" />

                                     
                                        <Image Source="exit.png" 
                           HeightRequest="20"
                           WidthRequest="20"
                           HorizontalOptions="End"
                           VerticalOptions="End" 
                           Margin="0,0,10,60">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                     
                                        <StackLayout Orientation="Horizontal" Spacing="10">
                                            <Label Text="{Binding ScanningNum, Mode=TwoWay}"
                               VerticalOptions="Center"
                               FontSize="14" 
                               FontFamily="bold"
                               TextColor="{StaticResource Black}"  
                               Margin="70,-35,0,0"/>
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal"
                                 VerticalOptions="Center" 
                                 Margin="0,-15,0,0">

                                            <Button Text="Edit" 
                                            BackgroundColor="Transparent" 
                                            TextColor="{StaticResource teal}" 
                                            VerticalOptions="Center" 
                                            HorizontalOptions="Start" 
                                            Padding="10" 
                                            FontSize="16"
                                            Margin="190,30,0,0" 
                                            Clicked="editClick"/>

                                            <Label Text="{Binding Quantity,StringFormat='Qty:{0}'}" 
                               FontSize="17" 
                               TextColor="{StaticResource Black}" 
                               VerticalOptions="Center" 
                               Margin="-160,30,0,0"/>
                                        </StackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

            </ScrollView>

        </Grid>

     

    </Grid>
</ContentPage>