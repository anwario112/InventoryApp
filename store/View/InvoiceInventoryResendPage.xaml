<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:local="clr-namespace:store.ViewModels"
             x:Class="store.View.InvoiceInventoryResendPage"
             Title="InvoiceInventoryResendPage">

    <CollectionView ItemsSource="{Binding Invoices}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout Orientation="Vertical" Padding="10" BackgroundColor="{StaticResource White}">

                 
                    <StackLayout Orientation="Horizontal">
                        <Grid Padding="10" WidthRequest="300" HorizontalOptions="FillAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding InvoiceNum, StringFormat='Invoice #{0}'}" FontSize="15" TextColor="{StaticResource Gray400}" Margin="0,5,0,0"/>
                            </StackLayout>

                            <StackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding Total, StringFormat='${0:F2}'}" FontSize="18" Margin="0,0,0,5"/>
                                <Label Text="{Binding DateCreated, Converter={StaticResource DateToRelativeTime}}" TextColor="{StaticResource Gray300}" FontSize="18"/>
                            </StackLayout>
                        </Grid>
                    </StackLayout>

                    <Button Text="Resend"
                                    Margin="0,10,0,0"
                                    Padding="10,5"
                                    FontSize="14"
                                    HeightRequest="40"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    HorizontalOptions="End"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:InvoiceInventoryResendViewModel}}, Path=SendInvoice}"
                                    CommandParameter="{Binding .}"/>

                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
