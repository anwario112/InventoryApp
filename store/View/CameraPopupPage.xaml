<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:camera="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="store.View.CameraPopupPage"
             Title="Scan Barcode">

    <ContentPage.Content>
        <Grid>
            <camera:CameraBarcodeReaderView
                x:Name="cameraView"
                IsDetecting="True"
                Options="{Binding BarcodeOptions}"
                CameraLocation="Rear"
                IsTorchOn="False" />

            <Button Text="Close"
                    VerticalOptions="End"
                    HorizontalOptions="Center"
                    Margin="0,0,0,20"
                    Clicked="OnCloseButtonClicked" />
        </Grid>
    </ContentPage.Content>
</ContentPage>