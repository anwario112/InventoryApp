<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="store.View.ItemPricePage"
             Title="Product Lookup"
             BackgroundColor="#F5F5F5">
   

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            
            <Entry x:Name="BarcodeEntry"
                   Placeholder="Enter Barcode"
                   BackgroundColor="White"
                   TextColor="Black"
                   FontSize="16"
                   HorizontalOptions="FillAndExpand"
                   Text="{Binding Barcode}" />

           
            <Label Text="{Binding DisplayedBarcode}"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Start"
                   Margin="0,10,0,0" />

            <Label Text="{Binding Product.ItemName, StringFormat='Item: {0}'}"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Start" />

           
            <Label Text="{Binding Product.SaleNetLL, StringFormat='Price (LL): {0}'}"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Start" />

          
            <Label Text="{Binding Product.SaleNetUSD, StringFormat='Price (USD): {0}'}"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Start" />

           
            <Label Text="{Binding Product.UnitDesc, StringFormat='Unit: {0}'}"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Start" />

           
            <Label Text="{Binding Product.Rate, StringFormat='1 USD = {0}'}"
                   FontSize="16"
                   TextColor="CadetBlue"
                   HorizontalOptions="Start"
                   Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>