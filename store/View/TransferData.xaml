<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="store.View.TransferData"
              xmlns:local="clr-namespace:store.View"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ur="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:Camera="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"         
             BackgroundColor="{StaticResource Gray1000}">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" BackgroundColor="{StaticResource teal}" Padding="10">

            <Grid RowDefinitions="Auto, Auto">

                <Label 

                    Grid.Row="0"

                    Text="Scan Barcode"

                    TextColor="White"

                    FontFamily="roman"

                    Padding="10,10,10,5"

                    FontSize="22" />


                <Border 

                    Grid.Row="1"

                    BackgroundColor="#20FFFFFF" 

                    Stroke="Transparent"

                    StrokeThickness="1"

                    Padding="5"

                    HorizontalOptions="Fill"

                    VerticalOptions="Center"

                    Margin="10,10,10,10">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="10" />

                    </Border.StrokeShape>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />
                            

                            <ColumnDefinition Width="Auto" />
                          

                        </Grid.ColumnDefinitions>


                        <Entry 

                            Placeholder="Search to add an Item"

                            BackgroundColor="Transparent"

                            TextColor="White"

                            FontFamily="roman"

                            HorizontalOptions="FillAndExpand"

                            Margin="0,0,5,0"

                            HeightRequest="40"

                            x:Name="Barcode"

                            IsVisible="true"
                            Text="{Binding BarcodeText}"

                            TextChanged="Entry_TextChanged"/>

                        <Image Source="camera.png" HeightRequest="25" WidthRequest="25" HorizontalOptions="End" Margin="0,0,20,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCameraImageTapped" />
                            </Image.GestureRecognizers>
                        </Image>


                     
                        

                    </Grid>

                </Border>

            </Grid>


            <Image Source="delete.png" HeightRequest="35" WidthRequest="35" Margin="280,0,0,70">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="clearData" />
                </Image.GestureRecognizers>
            </Image>

            <Image Source="saving.png" HeightRequest="35" WidthRequest="35" Margin="140,0,0,70">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SaveData" />
                </Image.GestureRecognizers>
            </Image>


        </Grid>


        <Grid Grid.Row="1" Padding="10">
            <ScrollView>
                <StackLayout>
                    <BoxView HeightRequest="1" 
                            BackgroundColor="{StaticResource Black}" 
                             HorizontalOptions="Fill" 
                             VerticalOptions="Start" 
                             IsVisible="False"
                             x:Name="SearchLine"/>


                    <ActivityIndicator x:Name="LoadingSpinner" IsVisible="False" IsRunning="False" />
                    <CollectionView ItemsSource="{Binding ItemCards}" Margin="0,10,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Transparent"
                                    StrokeThickness="2"
                                    BackgroundColor="{StaticResource White}"
                                    HeightRequest="110"
                                    WidthRequest="310"
                                    Margin="10">    

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Grid Padding="0">
                                        <BoxView WidthRequest="10" 
                                             BackgroundColor="{StaticResource teal}" 
                                             HorizontalOptions="Start" 
                                             VerticalOptions="Fill" />

                                        <Image Source="cardbarcode.png" 
                                           HeightRequest="40" 
                                           WidthRequest="40" 
                                           VerticalOptions="Center" 
                                           HorizontalOptions="Start" Margin="20,-10,0,0" />
                                        <Image Source="exit.png" 
                                           HeightRequest="20"
                                           WidthRequest="20"
                                           HorizontalOptions="End"
                                           VerticalOptions="End" 
                                           Margin="0,0,10,80">      
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                        <StackLayout Orientation="Vertical" HorizontalOptions="Start" VerticalOptions="Center" Spacing="5" Padding="16,0" Margin="50,0,0,0">
                                            <Label Text="{Binding ItemName,Mode=TwoWay}"
                                               VerticalOptions="Center"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Gray500}"  
                                               Margin="0,-5,0,0"/>

                                            <Label Text="{Binding ScanningNum,Mode=TwoWay}"
                                                   VerticalOptions="Center"
                                                   FontSize="14" 
                                                   TextColor="{StaticResource Gray500}"  
                                                   Margin="0,-5,0,0"/>

                                            <Label Text="{Binding Price, StringFormat='{0:C}'}"
                                               VerticalOptions="Center"
                                               FontSize="14" 
                                               TextColor="{StaticResource Gray500}"  
                                               Margin="0,-5,0,0"/>      
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal" 
                                             HorizontalOptions="End" 
                                             VerticalOptions="Center" 
                                             Margin="0,10,10,0">
                                            <Label Text="{Binding Quantity}" 
                                               FontSize="17" 
                                               TextColor="{StaticResource Black}" 
                                               VerticalOptions="Center" 
                                               Margin="0,20,5,0"/>
                                            
                                            <Label Text="{Binding Unit}" 
                                               VerticalOptions="Center"
                                               FontSize="14" 
                                               TextColor="{StaticResource Gray500}"  
                                               Margin="0,25,0,0"/>      
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal" 
                     HorizontalOptions="End" 
                     VerticalOptions="Center" 
                     Margin="10,60,180,0">

                                            <Button Text="Change" 
                                BackgroundColor="Transparent" 
                                TextColor="{StaticResource teal}" 
                                VerticalOptions="Center" 
                                HorizontalOptions="FillAndExpand" 
                                Padding="10" 
                                FontSize="12"
                                Clicked="Button_Clicked" />

                                            <Button Text="Packing" 
                            BackgroundColor="Transparent" 
                            TextColor="{StaticResource teal}" 
                            VerticalOptions="Center" 
                            HorizontalOptions="FillAndExpand" 
                            Padding="10" 
                            FontSize="13"
                            Clicked="Button_Clicked_2" Margin="10,0,0,0"/>
                                        </StackLayout>


                                        <StackLayout Orientation="Horizontal" 
                                     HorizontalOptions="End" 
                                     VerticalOptions="Center" 
                                     Margin="0,60,120,0">
                                            <Button Text="Edit" 
                            BackgroundColor="Transparent" 
                            TextColor="{StaticResource teal}" 
                            VerticalOptions="Center" 
                            HorizontalOptions="FillAndExpand" 
                            Padding="10" 
                            FontSize="13"
                            Clicked="Button_Clicked_1"  />
                                        </StackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

            </ScrollView>
           
        </Grid>

        <StackLayout HorizontalOptions="Fill" VerticalOptions="End" Margin="0,0,0,-100">

            <Border WidthRequest="260" 

                    HeightRequest="45" 

                    VerticalOptions="Center" 

                    HorizontalOptions="Center" 

                    BackgroundColor="{StaticResource White}"

                    Stroke="White"

                    StrokeThickness="2"

                    Padding="0"  x:Name="errorMessage"   IsVisible="{Binding IsErrorMessageVisible}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label TextColor="red"  Text="{Binding ErrorMessageText}" FontSize="20" x:Name="errorLabel"  HorizontalOptions="Center" />

            </Border>

        </StackLayout>

    </Grid>
</ContentPage>
